    "import random\n",
    "import functools\n",
    "\n",
    "\n",
    "LAST_NAME = \"LINSANGAN\"      \n",
    "SEED_NUM = 6              \n",
    "FAVORITE_ARTIST = \"STEVE PERRY\" \n",
    "\n",
    "\n",
    "\n",
    "def logger_decorator(func):\n",
    "    \"\"\"Decorator to record execution details in a log list.\"\"\"\n",
    "    @functools.wraps(func)\n",
    "    def wrapper(*args, **kwargs):\n",
    "        log_entry = f\"[LOG] Calling '{func.__name__}' with arguments: args={args}, kwargs={kwargs}\"\n",
    "        execution_log.append(log_entry)\n",
    "        result = func(*args, **kwargs)\n",
    "        execution_log.append(f\"[LOG] '{func.__name__}' returned: {result}\")\n",
    "        return result\n",
    "    return wrapper\n",
    "\n",
    "execution_log = []\n",
    "\n",
    "# Requirement 1: Generate student-specific equipment readings[cite: 1]\n",
    "def generate_equipment_data(surname: str, seed_digit: int, artist: str) -> list:\n",
    "    \"\"\"Generates a list of readings derived from student parameters.\"\"\"\n",
    "    seed_val = sum(ord(c) for c in surname) + seed_digit + sum(ord(c) for c in artist)\n",
    "    random.seed(seed_val)\n",
    "    \n",
    "    # Generate 5 readings including deliberate out-of-range/invalid values for testing\n",
    "    readings = [\n",
    "        round(random.uniform(40.0, 100.0), 2),\n",
    "        round(random.uniform(10.0, 120.0), 2),\n",
    "        \"INVALID_ENTRY\",  # String input to trigger exception handling\n",
    "        round(random.uniform(-10.0, 50.0), 2),\n",
    "        round(random.uniform(50.0, 90.0), 2)\n",
    "    ]\n",
    "    return readings\n",
    "\n",
    "# Requirement 2 & 3: Separate functions with Exception Handling[cite: 1]\n",
    "@logger_decorator\n",
    "def validate_reading(reading) -> float:\n",
    "    \"\"\"Validates that reading is a float/int within the normal operating range (0 to 100).\"\"\"\n",
    "    if not isinstance(reading, (int, float)):\n",
    "        raise TypeError(f\"Invalid data type received: {type(reading).__name__}\")\n",
    "    if reading < 0 or reading > 100:\n",
    "        raise ValueError(f\"Reading {reading} is out of valid bounds (0-100).\")\n",
    "    return float(reading)\n",
    "\n",
    "@logger_decorator\n",
    "def calculate_status_metric(valid_readings: list) -> float:\n",
    "    \"\"\"Calculates the average operating reading.\"\"\"\n",
    "    if not valid_readings:\n",
    "        return 0.0\n",
    "    return round(sum(valid_readings) / len(valid_readings), 2)\n",
    "\n",
    "@logger_decorator\n",
    "def classify_condition(avg_reading: float) -> str:\n",
    "    \"\"\"Classifies equipment condition based on average reading.\"\"\"\n",
    "    if avg_reading >= 75.0:\n",
    "        return \"OPTIMAL\"\n",
    "    elif avg_reading >= 50.0:\n",
    "        return \"WARNING - REQUIRES MAINTENANCE\"\n",
    "    else:\n",
    "        return \"CRITICAL FAULT\"\n",
    "\n",
    "def run_equipment_diagnostic():\n",
    "    raw_data = generate_equipment_data(LAST_NAME, SEED_NUM, FAVORITE_ARTIST)\n",
    "    valid_readings = []\n",
    "    validation_results = []\n",
    "\n",
    "    # Process each reading with exception handling[cite: 1]\n",
    "    for idx, reading in enumerate(raw_data, start=1):\n",
    "        try:\n",
    "            val = validate_reading(reading)\n",
    "            valid_readings.append(val)\n",
    "            validation_results.append(f\"Reading {idx} ({reading}): PASS\")\n",
    "        except (TypeError, ValueError) as e:\n",
    "            validation_results.append(f\"Reading {idx} ({reading}): FAIL -> {e}\")\n",
    "\n",
    "    # Calculation and Classification\n",
    "    avg_val = calculate_status_metric(valid_readings)\n",
    "    status = classify_condition(avg_val)\n",
    "\n",
    "    # Output formatting following Assessment Data sections[cite: 1]\n",
    "    print(\"=\" * 60)\n",
    "    print(\"1. EQUIPMENT DIAGNOSTIC SYSTEM RESULTS\")\n",
    "    print(\"=\" * 60)\n",
    "    print(f\"Generated Equipment Data: {raw_data}\\n\")\n",
    "    \n",
    "    print(\"Validation Results:\")\n",
    "    for res in validation_results:\n",
    "        print(f\"  - {res}\")\n",
    "    print()\n",
    "\n",
    "    print(\"Diagnostic Results:\")\n",
    "    print(f\"  - Valid Readings Processed : {valid_readings}\")\n",
    "    print(f\"  - Average Operating Value  : {avg_val}\")\n",
    "    print(f\"  - Classified Condition     : {status}\\n\")\n",
    "\n",
    "    print(\"Execution Log (via Decorator):\")\n",
    "    for log in execution_log:\n",
    "        print(f\"  {log}\")\n",
    "    print()\n",
    "\n",
    "    print(\"Final Output:\")\n",
    "    print(f\"  Equipment Status for Student [{LAST_NAME}_{SEED_NUM}]: {status} (Avg: {avg_val})\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "\n",
    "# ==============================================================================\n",
    "# PROBLEM 2: RECURSIVE FAULT TRACE\n",
    "# ==============================================================================\n",
    "\n",
    "def generate_fault_code(surname: str, seed_digit: int, artist: str) -> int:\n",
    "    \"\"\"Generates a numeric fault code based on student parameters.\"\"\"\n",
    "    code = (sum(ord(c) for c in surname) * seed_digit) + len(artist)\n",
    "    return max(code, 10)  # Ensures code is a positive integer >= 10\n",
    "\n",
    "def trace_fault_recursive(fault_code: int, level: int = 1, trace_sequence: list = None) -> list:\n",
    "    \"\"\"Recursively traces the fault code down to its termination condition[cite: 1].\"\"\"\n",
    "    if trace_sequence is None:\n",
    "        trace_sequence = []\n",
    "\n",
    "    # Record current state\n",
    "    step_info = f\"Level {level}: Processing Fault Code {fault_code}\"\n",
    "    trace_sequence.append(step_info)\n",
    "\n",
    "    # Base case / Termination condition[cite: 1]\n",
    "    if fault_code <= 1:\n",
    "        trace_sequence.append(f\"Termination condition reached at Level {level}.\")\n",
    "        return trace_sequence\n",
    "\n",
    "    # Recursive step: Integer divide by 2 or reduce odd values\n",
    "    next_code = fault_code // 2 if fault_code % 2 == 0 else fault_code - 1\n",
    "    return trace_fault_recursive(next_code, level + 1, trace_sequence)\n",
    "\n",
    "def run_recursive_fault_trace():\n",
    "    initial_code = generate_fault_code(LAST_NAME, SEED_NUM, FAVORITE_ARTIST)\n",
    "    trace_history = trace_fault_recursive(initial_code)\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"2. RECURSIVE FAULT TRACE RESULTS\")\n",
    "    print(\"=\" * 60)\n",
    "    print(f\"Generated Fault Code : {initial_code}\")\n",
    "    print(\"Diagnostic Sequence Trace:\")\n",
    "    for entry in trace_history:\n",
    "        print(f\"  -> {entry}\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "\n",
    "# --- MAIN EXECUTION ---\n",
    "if __name__ == \"__main__\":\n",
    "    run_equipment_diagnostic()\n",
    "    run_recursive_fault_trace()"
   ]
